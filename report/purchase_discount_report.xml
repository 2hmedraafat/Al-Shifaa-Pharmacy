<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_purchase_discount" model="ir.actions.report">
        <field name="name">Purchasing Discount Report</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pharmacy.report_purchase_discount_document</field>
        <field name="report_file">pharmacy.report_purchase_discount_document</field>
        <field name="print_report_name">'Purchasing_Discount_Report.pdf'</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('pharmacy.group_pharmacy_manager')), (4, ref('pharmacy.group_pharmacy_pharmacist'))]"/>
    </record>

    <template id="report_purchase_discount_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Purchasing Discount Report</h2>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th>Internal Ref</th>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Supplier</th>
                                <th>Date</th>
                                <th>Invoice</th>
                                <th class="text-end">Last Discount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="p">
                                <td><span t-field="p.default_code"/></td>
                                <td><span t-field="p.name"/></td>
                                <td><span t-field="p.categ_id"/></td>
                                <td><span t-field="p.last_purchase_discount_supplier_id"/></td>
                                <td><span t-field="p.last_purchase_discount_date"/></td>
                                <td><span t-field="p.last_purchase_discount_move_id"/></td>
                                <td class="text-end">
                                    <t t-if="p.last_purchase_discount_move_id">
                                        <span t-esc="'%.2f%%' % (p.last_purchase_discount or 0.0)"/>
                                    </t>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
