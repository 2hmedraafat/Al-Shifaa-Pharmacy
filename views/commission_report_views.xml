<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_commission_report_list" model="ir.ui.view">
        <field name="name">pharmacy.commission.report.list</field>
        <field name="model">pharmacy.commission.report</field>
        <field name="arch" type="xml">
            <list string="Commission Report" create="0" edit="0" delete="0">
                <field name="sale_order_id" string="Sale Order"/>
                <field name="customer_id" string="Customer"/>
                <field name="salesperson_id" string="Salesperson"/>
                <field name="product_id" string="Product"/>
                <field name="product_uom_qty" string="Qty" sum="Total Qty"/>
                <field name="price_unit" string="Unit Price"/>
                <field name="price_subtotal" string="Subtotal" sum="Total Subtotal"/>
                <field name="commission_amount" string="Commission" sum="Total Commission"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="order_state" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_commission_report_search" model="ir.ui.view">
        <field name="name">pharmacy.commission.report.search</field>
        <field name="model">pharmacy.commission.report</field>
        <field name="arch" type="xml">
            <search string="Commission Report">
                <field name="sale_order_id"/>
                <field name="customer_id"/>
                <field name="salesperson_id"/>
                <field name="product_id"/>
                <filter name="with_commission_or_confirmed" string="With Commission or Confirmed Orders" domain="['|', ('commission_amount', '&gt;', 0), ('order_state', 'in', ['sale', 'done'])]"/>
                <filter name="confirmed_orders" string="Confirmed Orders" domain="[('order_state', 'in', ['sale', 'done'])]"/>
                <filter name="with_commission" string="With Commission" domain="[('commission_amount', '&gt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_salesperson" string="Salesperson" context="{'group_by': 'salesperson_id'}"/>
                    <filter name="group_by_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_sale_order" string="Sale Order" context="{'group_by': 'sale_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pharmacy_commission_report_graph" model="ir.ui.view">
        <field name="name">pharmacy.commission.report.graph</field>
        <field name="model">pharmacy.commission.report</field>
        <field name="arch" type="xml">
            <graph string="Commission Report" type="bar">
                <field name="salesperson_id" type="row"/>
                <field name="commission_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_pharmacy_commission_report" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">pharmacy.commission.report</field>
        <field name="view_mode">list,graph</field>
        <field name="search_view_id" ref="view_pharmacy_commission_report_search"/>
        <field name="context">{'search_default_with_commission_or_confirmed': 1, 'search_default_group_by_salesperson': 1}</field>
    </record>
</odoo>