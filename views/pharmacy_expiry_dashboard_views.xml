<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pharmacy_expiry_dashboard_form" model="ir.ui.view">
        <field name="name">pharmacy.expiry.dashboard.form</field>
        <field name="model">pharmacy.expiry.dashboard</field>
        <field name="arch" type="xml">
            <form string="Expiry Alerts Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1>Expiry Alerts Dashboard</h1>
                        <p class="text-muted">
                            Current thresholds:
                            <strong><field name="warning_days" readonly="1" class="oe_inline"/> days</strong>
                            near-expiry and
                            <strong><field name="critical_days" readonly="1" class="oe_inline"/> days</strong>
                            critical.
                        </p>
                    </div>
                    <group col="4">
                        <button name="action_open_expired_lots" type="object" class="oe_stat_button" icon="fa-times-circle">
                            <field name="expired_lot_count" widget="statinfo" string="Expired"/>
                        </button>
                        <button name="action_open_critical_lots" type="object" class="oe_stat_button" icon="fa-clock-o">
                            <field name="critical_lot_count" widget="statinfo" string="Critical"/>
                        </button>
                        <button name="action_open_near_lots" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="near_lot_count" widget="statinfo" string="Near Expiry"/>
                        </button>
                        <button name="action_open_all_alert_lots" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="total_alert_lot_count" widget="statinfo" string="Total Alerts"/>
                        </button>
                    </group>
                    <div class="alert alert-info mt-3" role="alert">
                        Click any card to open the related lots with remaining stock in internal locations only.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SC2-UC-05: Dedicated page for expired medicine quants still in normal Internal locations. -->
    <record id="view_pharmacy_expired_medicines_quant_list" model="ir.ui.view">
        <field name="name">pharmacy.expired.medicines.quant.list</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list string="Expired Medicines" create="0" edit="0" delete="0" decoration-danger="pharmacy_lot_expiration_date">
                <field name="product_id"/>
                <field name="lot_id" string="Lot / Serial"/>
                <field name="pharmacy_lot_expiration_date" string="Expiry Date"/>
                <field name="location_id" string="Current Location"/>
                <field name="quantity" string="On Hand"/>
                <field name="reserved_quantity" string="Reserved"/>
                <field name="pharmacy_expired_transfer_qty" string="Available to Transfer"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_expired_medicines_quant_search" model="ir.ui.view">
        <field name="name">pharmacy.expired.medicines.quant.search</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <search string="Expired Medicines">
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="location_id"/>
                <filter name="with_available_qty" string="Available to Transfer" domain="[('pharmacy_expired_transfer_qty', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                <filter name="group_by_location" string="Location" context="{'group_by': 'location_id'}"/>
                <filter name="group_by_lot" string="Lot" context="{'group_by': 'lot_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_pharmacy_expired_medicines" model="ir.actions.act_window">
        <field name="name">Expired Medicines</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_pharmacy_expired_medicines_quant_list"/>
        <field name="search_view_id" ref="view_pharmacy_expired_medicines_quant_search"/>
        <field name="domain">[('lot_id', '!=', False), ('quantity', '&gt;', 0), ('location_id.usage', '=', 'internal'), ('location_id.is_expired_location', '=', False), ('product_id.product_tmpl_id.classification', '=', 'medicine'), ('lot_id.expiration_date', '!=', False), ('lot_id.expiration_date', '&lt;', context_today())]</field>
        <field name="context">{'search_default_group_by_product': 1, 'search_default_with_available_qty': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No expired medicines found in normal internal locations.</p>
            <p>After transfer, stock moves to the Expired Medicines location and disappears from this page.</p>
        </field>
    </record>

    <record id="server_action_pharmacy_transfer_expired_medicines" model="ir.actions.server">
        <field name="name">Transfer to Expired Location</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="binding_model_id" ref="stock.model_stock_quant"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_pharmacy_transfer_to_expired_location()</field>
    </record>

    <!-- Pharmacy app menu: Pharmacy -> Reports -> Expired Medicines -->
    <menuitem id="menu_pharmacy_expired_medicines"
              name="Expired Medicines"
              parent="menu_pharmacy_reports"
              action="action_pharmacy_expired_medicines"
              groups="pharmacy.group_pharmacy_manager,stock.group_stock_manager"
              sequence="4"/>

    <!-- Inventory app menu: Inventory -> Reporting -> Expired Medicines
         Uses the same action/view/server action as the Pharmacy menu, so no duplicate logic. -->
    <menuitem id="menu_inventory_expired_medicines"
              name="Expired Medicines"
              parent="stock.menu_warehouse_report"
              action="action_pharmacy_expired_medicines"
              groups="pharmacy.group_pharmacy_manager,stock.group_stock_manager"
              sequence="2"/>

    <record id="action_pharmacy_expiry_dashboard_server" model="ir.actions.server">
        <field name="name">Expiry Alerts Dashboard</field>
        <field name="model_id" ref="model_pharmacy_expiry_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <menuitem id="menu_pharmacy_expiry_dashboard"
              name="Expiry Alerts Dashboard"
              parent="menu_pharmacy_reports"
              action="action_pharmacy_expiry_dashboard_server"
              sequence="5"/>

    <menuitem id="menu_inventory_expiry_dashboard"
              name="Expiry Alerts Dashboard"
              parent="stock.menu_warehouse_report"
              action="action_pharmacy_expiry_dashboard_server"
              groups="pharmacy.group_pharmacy_manager,stock.group_stock_manager"
              sequence="3"/>
</odoo>
