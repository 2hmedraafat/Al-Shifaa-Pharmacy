<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_pharmacy_expiry" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.pharmacy.expiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Pharmacy" string="Pharmacy" name="pharmacy_expiry_settings">
                    <block title="Expiry Alert Thresholds" name="pharmacy_expiry_thresholds">
                        <setting string="Near-Expiry Warning" help="Default: 30 days before expiry.">
                            <field name="pharmacy_expiry_warning_days"/>
                        </setting>
                        <setting string="Critical Expiry Warning" help="Default: 7 days before expiry. Must be less than or equal to Near-Expiry Warning.">
                            <field name="pharmacy_expiry_critical_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
