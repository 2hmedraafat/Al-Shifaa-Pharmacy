<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_search_inherit_pharmacy_expired" model="ir.ui.view">
        <field name="name">stock.location.search.pharmacy.expired</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Expired Locations" name="pharmacy_expired_locations" domain="[('usage', '=', 'expired')]"/>
            </xpath>
        </field>
    </record>
</odoo>
