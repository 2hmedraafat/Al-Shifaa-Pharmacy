<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pharmacy_product_form_view" model="ir.ui.view">
        <field name="name">product.template.pharmacy.barcode</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='type']" position="before">
                <field name="is_scheduled_medicine"
                       string="Medicine is Scheduled"
                       groups="pharmacy.group_pharmacy_pharmacist,pharmacy.group_pharmacy_manager"
                       invisible="classification != 'medicine'"/>
                <field name="schedule_level"
                       invisible="classification != 'medicine' or not is_scheduled_medicine"
                       groups="pharmacy.group_pharmacy_pharmacist,pharmacy.group_pharmacy_manager"/>

                <field name="is_scheduled_medicine"
                       string="Medicine is Scheduled"
                       readonly="1"
                       groups="pharmacy.group_pharmacy_cashier"
                       invisible="classification != 'medicine' or not is_scheduled_medicine"/>
            </xpath>

            <xpath expr="//field[@name='barcode']" position="attributes">
                <attribute name="placeholder">1001</attribute>
            </xpath>

            <xpath expr="//field[@name='barcode']" position="after">
                <button name="action_generate_barcode"
                        string="Generate"
                        type="object"
                        class="btn btn-secondary btn-sm oe_inline"
                        confirm="This will replace the existing barcode. Are you sure?"/>
            </xpath>

        </field>
    </record>

    <!-- Force hide package_uom_id everywhere in product.template form -->
    <record id="pharmacy_hide_package_uom" model="ir.ui.view">
        <field name="name">product.template.hide.package.uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='package_uom_id']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
        </field>
    </record>

    <record id="pharmacy_product_list_view" model="ir.ui.view">
        <field name="name">product.template.pharmacy.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="is_scheduled_medicine" column_invisible="1"/>
                <field name="schedule_level"
                       string="Schedule"
                       optional="show"
                       decoration-danger="is_scheduled_medicine"
                       widget="badge"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_pharmacy" model="ir.ui.view">
        <field name="name">product.template.form.pharmacy.clean</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='type']" position="after">
                <field name="classification" widget="radio" options="{'horizontal': true}"/>
            </xpath>

            <!-- UC-01: show Generic Name directly under the product title -->
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="o_row mt-2">
                    <label for="generic_name" string="Generic Name:" class="fw-bold text-uppercase me-2"/>
                    <field name="generic_name"
                           nolabel="1"
                           class="oe_inline"
                           placeholder="e.g. Paracetamol, Amoxicillin ..."/>
                </div>
            </xpath>

            <!-- Sales Price -->
            <xpath expr="//label[@for='list_price']" position="replace">
                <label for="list_price" string="Sales Price"/>
            </xpath>

            <xpath expr="//field[@name='list_price']/.." position="replace">
                <div class="o_row">
                    <field name="list_price" class="oe_inline" required="1"/>
                    <span class="oe_inline mx-2">per</span>
                    <field name="sell_as" nolabel="1" class="oe_inline"/>
                    <field name="pharmacist_price_display"
                           readonly="1"
                           groups="pharmacy.group_pharmacy_manager,pharmacy.group_pharmacy_pharmacist"
                           invisible="1"/>
                </div>
            </xpath>

            <xpath expr="//page[@name='general_information']/group" position="after">
                <group colspan="2">
                    <separator string="Selling Configuration" colspan="2"/>
                    <group col="2" colspan="2">
                        <group>
                            <field name="sell_as" widget="radio" options="{'horizontal': true}"/>
                            <field name="units_per_package"/>
                            <field name="package_uom_id" readonly="1" invisible="True"/>
                            <field name="display_stock" readonly="1"/>
                            <field name="commission_pct"/>
                        </group>
                        <group/>
                    </group>

                    <separator string="Pharmacy Rules" colspan="2"/>
                    <group col="2" colspan="2">
                        <group>
                            <field name="max_qty_per_invoice" groups="pharmacy.group_pharmacy_manager"/>
                            <field name="government_price_lock" groups="pharmacy.group_pharmacy_manager,pharmacy.group_pharmacy_price_manager"/>
                        </group>
                        <group/>
                    </group>

                    <separator string="Low Stock Rule" colspan="2"/>
                    <group col="2" colspan="2">
                        <group>
                            <field name="low_stock_limit" groups="pharmacy.group_pharmacy_manager"/>
                            <field name="max_qty_when_low" groups="pharmacy.group_pharmacy_manager"/>
                        </group>
                        <group>
                            <field name="max_qty"/>
                            <field name="is_low_stock" readonly="1"/>
                        </group>
                    </group>
                </group>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Medicine Controls" name="medicine_controls" invisible="classification != 'medicine'">
                    <group string="Medicine Settings" col="2">
                        <group>
                            <field name="is_scheduled"/>
                            <field name="is_chronic"/>
                        </group>
                        <group>
                            <field name="lot_tracking_required"/>
                            <field name="expiry_tracking_required"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Cost History"
                      name="cost_history"
                      groups="pharmacy.group_pharmacy_manager,pharmacy.group_pharmacy_pharmacist">

                    <group string="Current Cost Information" col="2">
                        <field name="pharmacist_price_display" readonly="1"/>
                        <field name="list_price" readonly="1"/>
                    </group>

                    <field name="cost_history_ids" readonly="1" nolabel="1">
                        <list string="Cost History" create="0" edit="0" delete="0" default_order="date desc">
                            <field name="date"/>
                            <field name="cost"/>
                            <field name="unit_purchase_price"/>
                            <field name="qty_received"/>
                            <field name="picking_id"/>
                            <field name="purchase_order_id"/>
                            <field name="note"/>
                        </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Price History" name="price_history" groups="pharmacy.group_pharmacy_manager,pharmacy.group_pharmacy_price_manager">
                    <group string="Public Price Control" col="2">
                        <field name="list_price" readonly="1"/>
                        <field name="government_price_lock"/>
                    </group>
                    <field name="price_history_ids" readonly="1" nolabel="1">
                        <list string="Price History" create="0" edit="0" delete="0" default_order="date desc">
                            <field name="date"/>
                            <field name="old_price"/>
                            <field name="new_price"/>
                            <field name="currency_id"/>
                            <field name="user_id"/>
                            <field name="source"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="product_template_list_view_classification" model="ir.ui.view">
        <field name="name">product.template.list.classification.clean</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="generic_name" optional="show"/>
                <field name="classification" optional="show"/>
                <field name="is_low_stock" optional="show"/>
                <field name="low_stock_limit" optional="hide"/>
                <field name="max_qty_when_low" optional="hide"/>
                <field name="government_price_lock" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="pharmacy_cost_history_list_view" model="ir.ui.view">
        <field name="name">pharmacy.cost.history.list</field>
        <field name="model">pharmacy.cost.history</field>
        <field name="arch" type="xml">
            <list string="Cost History" create="0" edit="0" delete="0" default_order="date desc">
                <field name="product_tmpl_id"/>
                <field name="date"/>
                <field name="cost"/>
                <field name="unit_purchase_price"/>
                <field name="qty_received"/>
                <field name="picking_id"/>
                <field name="purchase_order_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="pharmacy_cost_history_graph_view" model="ir.ui.view">
        <field name="name">pharmacy.cost.history.graph</field>
        <field name="model">pharmacy.cost.history</field>
        <field name="arch" type="xml">
            <graph string="Cost Trend" type="line">
                <field name="date" type="row"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_pharmacy_cost_history" model="ir.actions.act_window">
        <field name="name">Product Cost History</field>
        <field name="res_model">pharmacy.cost.history</field>
        <field name="view_mode">list,graph</field>
    </record>

    <record id="pharmacy_invoice_block_log_list_view" model="ir.ui.view">
        <field name="name">pharmacy.invoice.block.log.list</field>
        <field name="model">pharmacy.invoice.block.log</field>
        <field name="arch" type="xml">
            <list string="Invoice Block Log" create="0" edit="0" delete="0" default_order="timestamp desc">
                <field name="timestamp"/>
                <field name="product_id"/>
                <field name="qty_attempted"/>
                <field name="qty_limit"/>
                <field name="user_id"/>
                <field name="overridden"/>
                <field name="override_by"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_pharmacy_invoice_block_log" model="ir.actions.act_window">
        <field name="name">Invoice Block Log</field>
        <field name="res_model">pharmacy.invoice.block.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="pharmacy_low_stock_override_log_list_view" model="ir.ui.view">
        <field name="name">pharmacy.low.stock.override.log.list</field>
        <field name="model">pharmacy.low.stock.override.log</field>
        <field name="arch" type="xml">
            <list string="Low Stock Override Log" create="0" edit="0" delete="0" default_order="timestamp desc">
                <field name="timestamp"/>
                <field name="product_id"/>
                <field name="qty_sold"/>
                <field name="max_qty_when_low"/>
                <field name="stock_at_sale"/>
                <field name="user_id"/>
                <field name="order_id"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_pharmacy_low_stock_override_log" model="ir.actions.act_window">
        <field name="name">Low Stock Override Log</field>
        <field name="res_model">pharmacy.low.stock.override.log</field>
        <field name="view_mode">list</field>
    </record>

    <record id="pharmacy_price_history_list_view" model="ir.ui.view">
        <field name="name">pharmacy.price.history.list</field>
        <field name="model">pharmacy.price.history</field>
        <field name="arch" type="xml">
            <list string="Price History" create="0" edit="0" delete="0" default_order="date desc">
                <field name="date"/>
                <field name="product_tmpl_id"/>
                <field name="old_price"/>
                <field name="new_price"/>
                <field name="currency_id"/>
                <field name="user_id"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="action_pharmacy_price_history" model="ir.actions.act_window">
        <field name="name">Price History</field>
        <field name="res_model">pharmacy.price.history</field>
        <field name="view_mode">list</field>
        <field name="groups_id" eval="[(4, ref('pharmacy.group_pharmacy_manager')), (4, ref('pharmacy.group_pharmacy_price_manager'))]"/>
    </record>

</odoo>