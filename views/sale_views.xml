<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_line_commission_view" model="ir.ui.view">
        <field name="name">sale.order.line.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']"
                   position="after">
                <field name="commission_amount"
                       string="Commission"
                       readonly="1"
                       optional="show"/>
            </xpath>

                        <!-- UC-SELL: inject allowed_uom_ids as invisible so domain works for all groups -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom']"
                   position="before">
                <field name="allowed_uom_ids" column_invisible="1"/>
            </xpath>

            <!-- UC-SELL: Hide UoM column like Purchase -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom']"
                   position="attributes">
                <attribute name="column_invisible">1</attribute>
                <attribute name="invisible">1</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Add Package Quantity before Unit Price -->
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']"
                   position="before">
                <field name="sale_package_qty_display" string="Package Quantity" readonly="1" width="180px"/>
            </xpath>

            <!-- Remove Packaging and Packaging Quantity columns -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_packaging_id']"
                   position="replace"/>
            <xpath expr="//field[@name='order_line']/list//field[@name='product_packaging_qty']"
                   position="replace"/>


        </field>
    </record>

</odoo>