<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_line_commission_view" model="ir.ui.view">
        <field name="name">sale.order.line.commission</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list//field[@name='price_subtotal']"
                   position="after">
                <field name="commission_amount"
                       string="Commission"
                       readonly="1"
                       optional="show"/>
            </xpath>

            <!-- UC-SELL: inject allowed_uom_ids as invisible so domain works for all groups -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom']"
                   position="before">
                <field name="allowed_uom_ids" column_invisible="1"/>
            </xpath>

            <!-- UC-SELL: Restrict UoM choices based on product sell_as -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom']"
                   position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True, 'no_open': True}</attribute>
                <attribute name="domain">[('id', 'in', allowed_uom_ids)]</attribute>
            </xpath>

        </field>
    </record>

</odoo>