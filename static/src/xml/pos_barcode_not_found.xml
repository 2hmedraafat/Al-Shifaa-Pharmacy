<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pharmacy.SharedBarcodeProductDialog">
        <Dialog title.translate="Shared Barcode Detected">
            <div class="p-3">
                <p class="mb-3">
                    Barcode <strong t-esc="props.barcode"/> is assigned to more than one product.
                </p>
                <p class="text-muted mb-3">Choose the correct product to add to the order.</p>

                <div class="list-group">
                    <button t-foreach="props.products"
                            t-as="product"
                            t-key="product.id"
                            type="button"
                            class="list-group-item list-group-item-action"
                            t-on-click="() => this.onSelect(product)">
                        <div class="d-flex justify-content-between align-items-center">
                            <strong t-esc="product.display_name"/>
                            <span class="badge text-bg-secondary">
                                <t t-esc="product.lst_price"/>
                            </span>
                        </div>
                        <div class="small text-muted mt-1">
                            <span t-if="product.default_code">Code: <t t-esc="product.default_code"/> | </span>
                            <span>Stock: <t t-esc="product.pharmacy_saleable_qty"/> | </span>
                            <span t-if="product.uom_id">UoM: <t t-esc="product.uom_id[1]"/></span>
                        </div>
                    </button>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
