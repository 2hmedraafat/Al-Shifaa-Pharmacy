<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pharmacy.PosExpiryProductCardIndicator"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-content')]" position="after">
            <t t-set="expiryState"
               t-value="props.product?.pharmacy_expiry_alert_state
                        || props.product?.raw?.pharmacy_expiry_alert_state
                        || props.product?._raw?.pharmacy_expiry_alert_state
                        || props.product?.data?.pharmacy_expiry_alert_state"/>
            <t t-set="nearestExpiry"
               t-value="props.product?.pharmacy_nearest_expiry_date
                        || props.product?.raw?.pharmacy_nearest_expiry_date
                        || props.product?._raw?.pharmacy_nearest_expiry_date
                        || props.product?.data?.pharmacy_nearest_expiry_date"/>
            <t t-set="nearestLot"
               t-value="props.product?.pharmacy_nearest_expiry_lot_name
                        || props.product?.raw?.pharmacy_nearest_expiry_lot_name
                        || props.product?._raw?.pharmacy_nearest_expiry_lot_name
                        || props.product?.data?.pharmacy_nearest_expiry_lot_name"/>
            <t t-set="daysRemaining"
               t-value="props.product?.pharmacy_expiry_days_remaining
                        ?? props.product?.raw?.pharmacy_expiry_days_remaining
                        ?? props.product?._raw?.pharmacy_expiry_days_remaining
                        ?? props.product?.data?.pharmacy_expiry_days_remaining"/>
            <t t-set="indicatorEnabled"
               t-value="props.product?.pharmacy_pos_expiry_indicator_enabled
                        ?? props.product?.raw?.pharmacy_pos_expiry_indicator_enabled
                        ?? props.product?._raw?.pharmacy_pos_expiry_indicator_enabled
                        ?? props.product?.data?.pharmacy_pos_expiry_indicator_enabled"/>
            <div t-if="indicatorEnabled !== false &amp;&amp; ['expired', 'critical', 'near'].includes(expiryState)"
                 t-att-class="'pharmacy-pos-expiry-badge pharmacy-pos-expiry-badge-' + expiryState"
                 t-att-title="daysRemaining !== undefined &amp;&amp; nearestLot ? ('Warning: expires in ' + daysRemaining + ' days (Lot: ' + nearestLot + ')') : (nearestExpiry ? ('Nearest expiry: ' + nearestExpiry) : 'Expiry warning')">
                <span class="pharmacy-pos-expiry-icon">⏰</span>
                <span t-if="expiryState === 'expired'">Expired</span>
                <span t-elif="expiryState === 'critical'">Critical</span>
                <span t-elif="expiryState === 'near'">Near Expiry</span>
            </div>
        </xpath>
    </t>
</templates>
