<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Barcode Sequence -->
        <record id="seq_pharmacy_barcode" model="ir.sequence">
            <field name="name">Pharmacy Internal Barcode</field>
            <field name="code">pharmacy.barcode</field>
            <field name="prefix">299</field>
            <field name="padding">9</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Prescription Sequence -->
        <record id="seq_pharmacy_prescription" model="ir.sequence">
            <field name="name">Pharmacy Prescription</field>
            <field name="code">pharmacy.prescription</field>
            <field name="prefix">RX-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Controlled Register Sequence -->
        <record id="seq_pharmacy_register" model="ir.sequence">
            <field name="name">Controlled Substances Register</field>
            <field name="code">pharmacy.controlled.register</field>
            <field name="prefix">CSR-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

    </data>
</odoo>