<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="ir_cron_pharmacy_expiry_activities" model="ir.cron">
        <field name="name">Pharmacy Expiry Alert Activities</field>
        <field name="model_id" ref="stock.model_stock_lot"/>
        <field name="state">code</field>
        <field name="code">model.action_create_expiry_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
