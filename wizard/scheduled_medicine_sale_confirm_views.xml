<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_scheduled_medicine_confirm_wizard" model="ir.ui.view">
        <field name="name">sale.scheduled.medicine.confirm.wizard.form</field>
        <field name="model">sale.scheduled.medicine.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Scheduled Medicine!">
                <group>
                    <field name="message" readonly="1" nolabel="1"/>
                    <field name="medicine_names" readonly="1" nolabel="1"
                           invisible="not medicine_names"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
