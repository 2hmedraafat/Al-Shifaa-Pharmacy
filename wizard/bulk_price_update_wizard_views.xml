<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pharmacy_bulk_price_update_wizard_form" model="ir.ui.view">
        <field name="name">pharmacy.bulk.price.update.wizard.form</field>
        <field name="model">pharmacy.bulk.price.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Price Update">
                <group>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="update_type" widget="radio"/>
                    <field name="percentage" invisible="update_type != 'percentage'" required="update_type == 'percentage'"/>
                    <field name="fixed_amount" invisible="update_type != 'fixed'" required="update_type == 'fixed'"/>
                    <field name="skip_locked_products"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_bulk_price_update_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Price Update</field>
        <field name="res_model">pharmacy.bulk.price.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('pharmacy.group_pharmacy_price_manager')), (4, ref('pharmacy.group_pharmacy_manager'))]"/>
    </record>

    <record id="action_product_template_bulk_price_update" model="ir.actions.act_window">
        <field name="name">Bulk Price Update</field>
        <field name="res_model">pharmacy.bulk.price.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('pharmacy.group_pharmacy_price_manager')), (4, ref('pharmacy.group_pharmacy_manager'))]"/>
    </record>

    <menuitem id="menu_pharmacy_bulk_price_update"
              name="Bulk Price Update"
              parent="menu_pharmacy_prescriptions_root"
              action="action_pharmacy_bulk_price_update_wizard"
              groups="pharmacy.group_pharmacy_price_manager,pharmacy.group_pharmacy_manager"
              sequence="30"/>

</odoo>
