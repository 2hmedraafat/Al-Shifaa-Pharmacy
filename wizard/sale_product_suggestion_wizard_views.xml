<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_product_suggestion_wizard_view_form" model="ir.ui.view">
        <field name="name">sale.product.suggestion.wizard.form</field>
        <field name="model">sale.product.suggestion.wizard</field>
        <field name="arch" type="xml">
            <form string="Product Suggestions">
                <sheet>
                    <group>
                        <field name="sale_order_id" invisible="1"/>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="selected" string="Add"/>
                            <field name="suggestion_type" widget="badge"/>
                            <field name="base_product_tmpl_id"/>
                            <field name="suggested_product_tmpl_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="available_qty"/>
                            <field name="list_price"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_add_selected_products"
                            string="Add Selected Products"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
